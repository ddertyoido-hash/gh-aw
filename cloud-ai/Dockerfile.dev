# Development image for the Cloud AI web + API service.
#
# It deliberately does NOT copy application source into the image: the compose
# service bind-mounts the checkout and installs dependencies at startup, so
# edits are picked up by the dev servers without rebuilding. Build tools are
# included as a fallback in case a native dependency (better-sqlite3) has to
# compile from source instead of using a prebuilt binary.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NODE_ENV=development
