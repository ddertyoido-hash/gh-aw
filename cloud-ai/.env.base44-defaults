# Cloud AI - placeholder defaults for local development.
#
# This file exists so the app starts without credentials and shows its setup
# screen. Every value here is empty on purpose: an empty value means "not
# configured", and it can never override a real value.
#
# Precedence: values in /run/base44/app.env (the Base44 secrets file) are loaded
# AFTER this file, so the real secret always wins. Never put a real key here -
# committed files are not a safe place for credentials.

# OpenAI - chat, vision, image generation, speech and transcription.
OPENAI_API_KEY=

# Anthropic - Claude models (chat, vision, PDF documents).
ANTHROPIC_API_KEY=

# Google - Gemini models and Imagen image generation (GEMINI_API_KEY also works).
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=

# Stripe billing (optional): checkout for the Pro plan.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Optional overrides.
# CLOUD_AI_TRANSCRIBE_MODEL=whisper-1
# CLOUD_AI_SPEECH_MODEL=tts-1
# CLOUD_AI_PUBLIC_URL=
